akr 0.1
project pixelkit

record pixelkit.work.accessibility-validation/1 : work {
    title "Accessibility through the App adapter, tested with real assistive technology"
    state proposed
    scope [
        path "crates/liminalkit-ui/src/semantics.rs",
        path "crates/liminalkit-windowing/src/host.rs",
        path "crates/liminalkit/src/app.rs"
    ]
    intent """
        Give App<S> the accessibility feature: own a Semantics, attach it with Ui::with_semantics every frame, publish the tree through PixelApp::accessibility_tree and route actions back through Input, so a Screen gets a screen-reader tree without implementing PixelApp. Then test, by hand, with Orca on Linux and VoiceOver on macOS: Tab and typed-focus transitions announce the right control, a modal dropdown hides the background controls, text fields report value and caret, and an action request on a button activates it. Record the findings as evidence with the AT version.
        """
    note """
        The adapter half was done 2026-11-03: with the `accessibility` feature App owns a Semantics, begins it with the window or Screen::title each frame, attaches it to the Ui, publishes Semantics::update from accessibility_tree, routes on_accessibility_action through Semantics::action, and invalidates on layout change and focus reset. Overlay marks modal frames. What remains is the assistive-technology testing, which needs a person at a machine with Orca or VoiceOver.
        """
    after [ @pixelkit.work.adoptability-pass ]
    implements [ @pixelkit.decision.facade-crate-and-app-adapter ]
    source {
        kind external
        role origin
        document "outside-review-2026-11-03"
        use """
            Section 3: practical accessibility needs testing across focus transitions, modal dialogs, text fields and assistive technologies.
            """
    }
}

record pixelkit.work.adoptability-pass/1 : work {
    title "Adoptability pass from the 2026-11-03 outside review: layout solvers, typed focus, App adapter, units contract, facade crate"
    state completed
    scope [
        path "CONTRIBUTING.md",
        path "Cargo.toml",
        path "README.md",
        path "crates/liminalkit-shell/src/scale.rs",
        path "crates/liminalkit-ui/**",
        path "crates/liminalkit-windowing/Cargo.toml",
        path "crates/liminalkit/**"
    ]
    intent """
        Make the existing architecture usable by callers who did not build it, without changing it: stateless stack/flow/inset/alignment layout solvers in liminalkit-ui::layout; Focus<K> generic over a caller-supplied key with register_id/register_id_at while Focus<usize> keeps the positional API; theme dimensional tokens scaled at every use site so the documented units contract holds at HiDPI, plus Ui::rect, Ui::metrics and Scale::rect; a top-level liminalkit crate with re-exports, a prelude, and the App/Screen/Context adapter; cross-crate examples moved there (hello, window, window_lowlevel, panes, multi, touch, touch_tuning) ending the ui/windowing dev-dependency cycle; crate descriptions, repository and workspace version requirements; README repositioned around why-this-and-not-egui with a quick start and Units/Layout/Keyboard-focus sections; CONTRIBUTING.md that does not depend on AKR.
        """
    note """
        Done in one session on 2026-11-03. Publishing to crates.io was explicitly out of scope by the owner's instruction; the packaging metadata added is inert until that decision is made.
        """
    acceptance {
        check hidpi-proportions {
            statement """
                The gallery rendered at 2x keeps the same proportions as at 1x, showing theme sizes follow the scale.
                """
            method observation
            verified_by [ @pixelkit.evidence.gallery-renders-at-2x/1 ]
        }
        check lint-and-docs {
            statement """
                No clippy warnings in new or changed code; rustdoc with warnings denied is clean for liminalkit, liminalkit-ui and liminalkit-shell.
                """
            method command
            command "cargo clippy --workspace --all-targets --features liminalkit/test-fonts && RUSTDOCFLAGS=\"-D warnings\" cargo doc -p liminalkit -p liminalkit-ui -p liminalkit-shell --no-deps --features liminalkit/test-fonts"
            verified_by [ @pixelkit.evidence.adoptability-pass-clippy-doc/1 ]
        }
        check workspace-tests {
            statement """
                cargo test --workspace --features liminalkit/test-fonts passes, including the new focus, layout, Scale::rect and App adapter tests.
                """
            method command
            command "cargo test --workspace --features liminalkit/test-fonts"
            verified_by [ @pixelkit.evidence.adoptability-pass-tests/1 ]
        }
    }
    implements [
        @pixelkit.decision.device-pixel-rects,
        @pixelkit.decision.facade-crate-and-app-adapter,
        @pixelkit.policy.explicit-state-toolkit
    ]
    source {
        kind external
        role origin
        document "outside-review-2026-11-03"
        use """
            The Critical and High rows for external adoption, layout and focus, and the coordinate-system finding.
            """
    }
}

record pixelkit.work.explicit-interaction-lifecycles/1 : work {
    title "Make interaction and host lifecycle transitions explicit"
    state completed
    scope [ path "crates/**" ]
    intent """
        Implement the interaction-state audit recommendations: modal dropdown input ownership, touch-contact lifecycle safety, pane capture invalidation, presenter recovery and native lifecycle state, gesture and clipboard operation states, KMS scheduling/device reconciliation, and touch-tuning modes. Preserve existing simple enum/Option models.
        """
    acceptance {
        check regressions {
            statement """
                Regression tests cover popup input ownership, contact replacement and invalid slots, pane restructuring capture, and presenter resize retry.
                """
            method command
            verified_by [ @pixelkit.evidence.interaction-lifecycle-regressions/1 ]
        }
        check state-models {
            statement """
                Gesture, clipboard, host resources, KMS pacing/discovery and touch-tuning mode transitions use explicit owned state with shared cancellation paths.
                """
            method manual
            verified_by [ @pixelkit.evidence.interaction-lifecycle-state-review/1 ]
        }
        check workspace {
            statement """
                Workspace tests, examples, formatting and applicable lint checks pass.
                """
            method command
            verified_by [ @pixelkit.evidence.interaction-lifecycle-regressions/1 ]
        }
    }
}

record pixelkit.work.hardware-validation/1 : work {
    title "Validate KMS, touch gestures and scroll physics on real Raspberry Pi hardware"
    state proposed
    scope [
        path "crates/liminalkit-kms/**",
        path "crates/liminalkit-shell/src/gesture.rs",
        path "crates/liminalkit-shell/src/scroll_physics.rs",
        path "crates/liminalkit-shell/src/touch_replay.rs"
    ]
    intent """
        Run the KMS host on at least two real panels (the official Pi touch display and an HDMI panel with a USB touch controller): mode set at the native and one non-native mode, all four rotations, two refresh rates, hotplug of the touch device, and a 24-hour soak for the missing-flip deadline. Run touch_tuning on a touchscreen, record sessions with touch_replay, and calibrate the GestureConfig and ScrollConfig defaults from those recordings. Each 'untested on hardware' label in the README and module docs is removed only by an evidence record citing the device, the kernel and the recording. Keep the recordings as regression fixtures.
        """
    note """
        Not started. Blocked on access to the hardware, which is the owner's to arrange.
        """
    after [ @pixelkit.work.adoptability-pass ]
    source {
        kind external
        role origin
        document "outside-review-2026-11-03"
        use """
            Section 3: the gesture and scroll-physics layer and the KMS host need validation on actual displays, rotations, refresh rates and touch controllers.
            """
    }
}

record pixelkit.work.performance-comparison/1 : work {
    title "Reproducible performance comparison against egui and Freya on the same screen"
    state proposed
    scope [ path "crates/liminalkit-ui/examples/**", path "crates/liminalkit/examples/**" ]
    intent """
        Turn the reported ~30% memory reduction over Freya in Lege into a reproducible result. Build one operational screen (a table, a form, a scrolling list, a few controls) in liminalkit, egui and Freya in a separate benchmark workspace outside the published crates. Measure resident memory, startup latency, idle CPU (egui can also sleep, so measure rather than claim), p95 frame time under scripted interaction, binary size, and the same at 1080p, 1440p and 4K to find where software rendering's cost overtakes its memory savings. Report numbers with the machine, the resolution and the commit, and commit the harness so the table can be regenerated.
        """
    note """
        The liminalkit half of the resolution sweep exists since 2026-11-03: crates/liminalkit/examples/frame_bench.rs renders one operational screen headlessly at 720p to 4K and prints cold, p50, p95 and max redraw times and resident memory; the first measurement is evidence frame-bench-resolution-sweep (about 2 ms per full redraw at 1080p, 10 ms at 4K on an i7-13700H). Still open: the same screen in egui and Freya with their windows, idle CPU, startup and binary size, in a separate workspace.
        """
    after [ @pixelkit.work.adoptability-pass ]
    implements [ @pixelkit.policy.explicit-state-toolkit ]
    source {
        kind external
        role origin
        document "outside-review-2026-11-03"
        use """
            Section 5: evidence of performance, not just claims, with the list of measurements and the resolution crossover question.
            """
    }
}

record pixelkit.work.public-docs/1 : work {
    title "Screenshots, an architecture guide, a tutorial, and crate-level API docs for outside readers"
    state proposed
    scope [ path "README.md", path "crates/*/src/lib.rs", path "docs/**" ]
    intent """
        Add to the README a screenshot of a real Lege screen and of a kiosk screen on a Pi, and the gallery render. Write docs/ARCHITECTURE.md (the crates, the frame lifecycle, units, focus, the two hosts, the presenter seam) and a short tutorial that grows hello.rs into a form with a table and a dropdown. Give every crate a README and a lib.rs doc that answers what it is for and what it is not, written for someone who has not read the others. Make RUSTDOCFLAGS=-D warnings clean for the whole workspace and keep it clean in CI.
        """
    note """
        Done 2026-11-03: docs/ARCHITECTURE.md; docs/TUTORIAL.md with its compiled counterpart crates/liminalkit/examples/tutorial.rs; a README per component crate referenced from each Cargo.toml; a warnings-clean rustdoc for the whole workspace; .github/workflows/ci.yml running fmt, clippy -D warnings, tests with and without accessibility and bidi, docs, and the gallery render (written, not yet observed running on GitHub); and, in commit 900358a, the gallery render as docs/screenshots/gallery.png (77 KB after recompression, from the 1.1 MB the toolkit's own encoder writes) at the top of the README, which crates.io resolves against the repository URL. Still open: the screenshots of a real Lege screen and a kiosk on a Pi, which need those builds and that hardware.
        """
    after [ @pixelkit.work.adoptability-pass ]
    source {
        kind external
        role origin
        document "outside-review-2026-11-03"
        use """
            Section 6 and the Medium documentation row: screenshots, published examples, tutorials, crate-level docs, and a contribution path independent of AKR.
            """
    }
}

record pixelkit.work.publish-packaging/1 : work {
    title "Packaging for a crates.io release, held until the owner decides the toolkit is ready"
    state proposed
    scope [ path "Cargo.toml", path "crates/*/Cargo.toml" ]
    intent """
        When and if publishing is decided: cargo publish --dry-run for each crate in the order raster, text, shell, ui, windowing, kms, liminalkit, and a v0.5.0 tag. Already in place: version 0.5.0 derived per @pixelkit.decision.versioning-method with matching requirements on every path dependency, a search-oriented description with keywords and categories on every crate, a README per crate referenced from its manifest, LICENSE files at the root, CHANGELOG.md with every generation, the test fonts out of every publishable crate per @pixelkit.decision.test-fonts-unpublished-crate, and cargo package verifying the leaf crate.
        """
    note """
        On 2026-11-03 the owner first deferred publishing, then asked that the crates be prepared for publication without being published. Done in commits 900358a and ff2315c: descriptions written so they surface in crates.io searches, keywords and categories on all seven publishable crates, cargo package --list reviewed for every crate, the fonts moved into the unpublished liminalkit-test-fonts crate (liminalkit-text now packages only its sources, README and example), and the version set to 0.5.0 from the commit history. Nothing has contacted the registry for a publish, including a dry run, which is the owner's call. The dependent crates cannot be dry-run until their path dependencies exist on crates.io, so the first real publish is sequential in the listed order.
        """
    after [ @pixelkit.work.performance-comparison, @pixelkit.work.public-docs ]
    source {
        kind external
        role origin
        document "outside-review-2026-11-03"
        use """
            Section 4, recorded for completeness; the recommendation to publish was declined by the owner.
            """
    }
}

record pixelkit.work.raster-simd-coverage/1 : work {
    title "Measured exact SIMD coverage in raster kernels"
    state proposed
    intent """
        Keep coverage merging bit exact while adding SIMD only where profiles
        justify it. The initial u8x32 path handles rows of at least 1024 bytes;
        shorter glyph spans retain the scalar loop. Compare scalar and vector
        medians for short and long rows on aarch64 and x86_64, then expand to
        alpha coverage blending or opaque bitmap rows only after equivalent
        output and a measured speed benefit. Preserve clipped tails and portable
        behavior on unsupported targets.
        """
}

record pixelkit.work.text-rendering-quality/1 : work {
    title "Gamma-corrected text coverage, opt-in vertical hinting and stem darkening"
    state completed
    intent """
        Make small UI text (11 to 17 px, both polarities, scales 1 to 2) crisper
        and more evenly weighted: correct glyph coverage for the sRGB blend with
        a per-pair coverage curve (text and background lightness), and offer
        opt-in vertical grid fitting and horizontal stem darkening through a
        defaulted TextRendering held by TextCache, so existing callers compile
        unchanged and TextRendering::UNCORRECTED reproduces the old output.
        """
    note """
        Defaults: gamma 1.8, contrast 0.5, Hinting::None, stem_darkening 0.
        Vertical hinting measured about 8% less grey at horizontal edges over
        9-34 px but only 2% at sizes whose x-height is already whole, so it is
        opt-in. Before/after sheets were rendered outside the repository.
        """
    acceptance {
        check uncorrected-identical {
            statement """
                Rendering with TextRendering::UNCORRECTED reproduces the previous toolkit's pixels byte for byte.
                """
            method observation
            verified_by [ @pixelkit.evidence.text-rendering-uncorrected-identical/1 ]
        }
        check workspace-tests {
            statement """
                The workspace test suite passes, including the curve, mapped-span and rendering-option tests.
                """
            method command
            command "cargo test --workspace"
            verified_by [ @pixelkit.evidence.text-rendering-tests/1 ]
        }
    }
    author "dk"
}

record pixelkit.work.text-shaping-fallback/1 : work {
    title "Font fallback across scripts, bidirectional text, and an optional mature shaper behind a feature"
    state proposed
    scope [ path "crates/liminalkit-text/**" ]
    intent """
        Keep the dependency-free renderer as the default path and add what a general caller needs: per-run font fallback that walks a FontSet's chains by script and coverage rather than only by missing glyph; Unicode bidirectional reordering for mixed-direction lines; and an optional `shaper-rustybuzz` (or equivalent) feature that routes shaping through a full OpenType engine while liminalkit-text keeps rasterization, caching and wrapping. The feature must be off by default and must not change output for the bundled Latin and Thai fonts when off. Measure the binary-size and startup cost of the feature so an appliance build can refuse it knowingly.
        """
    note """
        Bidi slice done 2026-11-03 (commit 900358a): the `bidi` feature of liminalkit-text, per @pixelkit.decision.bidi-behind-feature, with tests for an override, a mixed line, mirrored brackets and marks staying on their base in a reversed run, in CI with and without the feature. Direction controls are never drawn, feature or not. Still open: script-aware fallback (today fallback is per character by coverage, which is correct for Latin+Thai but splits a run of a script the primary partly covers), Arabic-style joining which needs lookup selection by script and feature tag, and the external-shaper decision with its size and startup measurement. Right-to-left editing in text fields (visual caret, selection) is a UI-crate follow-up once a right-to-left face is part of the test fixtures.
        """
    after [ @pixelkit.work.adoptability-pass ]
    implements [ @pixelkit.policy.explicit-state-toolkit ]
    source {
        kind external
        role origin
        document "outside-review-2026-11-03"
        use """
            The High row for text: font fallback, broader Unicode shaping, bidirectional text, and the suggestion of an optional rustybuzz integration.
            """
    }
}

record pixelkit.work.touch-interactions/1 : work {
    title "Experimental original touch interaction physics and playground"
    state completed
    intent """
        Implement original renderer-independent tap/drag/pinch arbitration, release
        velocity, configurable inertial/elastic/snapping scrolling, and a touch tuning
        playground with bounded recording, deterministic replay and motion graphs.
        Use no third-party gesture or physics implementation. Clearly label the new
        APIs and example experimental and behavior/hardware/feel untested. Perform
        compile and formatting checks only; provide regression tests for later runs.
        """
    note """
        EXPERIMENTAL / UNTESTED. Implementation and compile checks are complete only.
        The twelve regression cases are provided but unrun. Interactive behavior,
        physical hardware, latency and subjective touch feel are explicitly untested.
        Recording is memory-only. Nested parent capture and fling transfer remain
        application policy; the physics API supplies unconsumed hard-bound drag deltas.
        """
    verified_by [ @pixelkit.evidence.touch-interactions-compile/1 ]
}

record pixelkit.work.touchscreen/1 : work {
    title "Touchscreen UI building blocks"
    state completed
    intent """
        Add host-independent touchscreen primitives, contact lifecycle and gesture
        tracking, an explicit existing-widget pointer adapter, native winit delivery,
        and a runnable touch diagnostics example. Preserve hardware-independent
        rendering and distinguish host event timing from physical touch latency.
        """
    verified_by [ @pixelkit.evidence.touchscreen-tests/1 ]
}

record pixelkit.work.ui-capabilities/1 : work {
    title "Dialogs, menus, overlays, drag-and-drop and multi-line text, as caller-owned state"
    state completed
    scope [ path "crates/liminalkit-ui/**" ]
    intent """
        Add the capabilities an operational application reaches for next, each in the shape Dropdown already has: a value the screen owns, an input prepass that claims clicks and keys before the background draws, and a draw call that runs last. A modal dialog (scrim, focus trapped inside, Escape and a result enum); a context menu and a menu bar sharing the popup machinery; a generic overlay/popover anchored to a rect; in-app drag-and-drop between lists with a caller-owned DragState (OS file drops already arrive through on_file_drop); a multi-line text field with wrapping, vertical scrolling and the same grapheme-boundary editing as the single-line one. Every one of these must state in its signature what it owns and what persists between frames.
        """
    note """
        Done 2026-11-03 in liminalkit-ui: overlay.rs (Overlay with open_dialog/open_popover, Placement, its own Focus, keys taken in handle_input and restored in draw via the new Input::restore_keys), menu.rs (Menu over Dropdown's popup with Ui::context_menu and menu_width), drag.rs (Drag<T> with source/target/ghost and a press threshold that leaves clicks to the control), textarea.rs (TextAreaState over TextFieldState: wrapped paragraphs, Up/Down keeping the column, line Home/End, Enter, click placement, caret kept in view). A menu bar was not built: a context menu at a point covers the operational case and a bar is the same popup anchored to a strip, left for when a screen needs it.
        """
    acceptance {
        check capability-tests {
            statement """
                Overlay, Menu, Drag and TextAreaState each have state-level tests covering open, claim-before-background, dismiss, and the keyboard paths, and the workspace suite passes.
                """
            method command
            command "cargo test --workspace --features liminalkit/test-fonts"
            verified_by [ @pixelkit.evidence.capabilities-pass-tests/1 ]
        }
        check lint-clean {
            statement """
                The new modules add no clippy or rustdoc warnings.
                """
            method command
            command "cargo clippy --workspace --all-targets --features liminalkit/test-fonts,liminalkit/accessibility && RUSTDOCFLAGS=\"-D warnings\" cargo doc --workspace --no-deps --features liminalkit/test-fonts,liminalkit/accessibility"
            verified_by [ @pixelkit.evidence.workspace-lint-and-docs-clean/1 ]
        }
    }
    after [ @pixelkit.work.adoptability-pass ]
    implements [ @pixelkit.policy.explicit-state-toolkit ]
    source {
        kind external
        role origin
        document "outside-review-2026-11-03"
        use """
            The Medium row for UI capabilities: dialogs, menus, overlays, drag-and-drop, richer text input.
            """
    }
}

record pixelkit.work.windowing-crate/1 : work {
    title "Windowing crate: host move, multi-window, panes, in-app windows"
    state completed
    intent """
        Move OS-window hosting out of pixelkit-shell into a new pixelkit-windowing
        crate, add a multi-OS-window runner, and add in-app draggable panes plus
        in-app floating windows behind small caller-owned state types, with unit
        tests for the layout and drag state machines.
        """
    note """
        User decisions (2026-09-29): both OS-level and in-app windows; new crate
        named pixelkit-windowing. Event vocabulary used by shell's Input collector
        (KeyInput, Modifiers, MouseButton) stays in pixelkit-shell; host/app
        protocol types move with the host.
        """
}
