akr 0.1
project pixelkit

record pixelkit.evidence.adoptability-pass-clippy-doc/1 : evidence {
    title "Clippy and rustdoc clean for the changed crates"
    state verified
    result pass
    method command
    observed_at git:19c5cd393ad6ee802170a789fd3fd1e4ff84bcdf
    command "cargo clippy --workspace --all-targets --features liminalkit/test-fonts; RUSTDOCFLAGS=\"-D warnings\" cargo doc -p liminalkit -p liminalkit-ui -p liminalkit-shell --no-deps --features liminalkit/test-fonts"
    summary """
        Clippy reports eight warnings, all pre-existing in files not touched by this pass (clipboard.rs, painter.rs, windows.rs, host.rs, palette.rs, toast.rs lines unrelated to the edits) and none in the new or changed code. rustdoc with warnings denied is clean for liminalkit, liminalkit-ui and liminalkit-shell; liminalkit-raster has two pre-existing broken intra-doc links in png/.
        """
}

