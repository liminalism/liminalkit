    method observation
    observed_at git:19c5cd393ad6ee802170a789fd3fd1e4ff84bcdf
    command "cargo run -p liminalkit-ui --example gallery --features test-fonts -- 2.0"
    summary """
        target/gallery@2x.png (1440x1040) was inspected next to target/gallery@1x.png (720x520): panels, borders, corner radii, list rows and the tooltip keep the same proportions at both scales after theme tokens are scaled at their use sites.
        """
}

