akr 0.1
project pixelkit

record pixelkit.papercut.a-standalone-audit-harness-importing-the-kms/1 : papercut {
    title "A standalone audit harness importing the KMS rotation source failed to…"
    state verified
    statement """
        A standalone audit harness importing the KMS rotation source failed to compile until bytemuck was passed explicitly via --extern. Linking the application libraries does not make all direct source-module dependencies available to a standalone rustc invocation.
        """
    observed_at git:19c5cd393ad6ee802170a789fd3fd1e4ff84bcdf
    about "rustc"
    author "Codex"
    created_at 2026-11-01
}

record pixelkit.papercut.akr-explain-acceptance-does-not-describe-the/1 : papercut {
    title "akr explain acceptance does not describe the optional acceptance slot;…"
    state verified
    statement """
        akr explain acceptance does not describe the optional acceptance slot; it accepts only record kinds or rule codes. Work schema lists the slot without its fragment syntax.
        """
    observed_at git:614c9c6e84ce3cd0bc6c81988f636b493b30a497
    author "codex"
    created_at 2026-10-15
}

record pixelkit.papercut.building-docs-with-rustdocflags-d-warnings/1 : papercut {
    title "Building docs with RUSTDOCFLAGS=-D warnings fails in liminalkit-raster…"
    state verified
    statement """
        Building docs with RUSTDOCFLAGS=-D warnings fails in liminalkit-raster before any other crate is documented: png/decode.rs links a private MAX_DIMENSION and png/mod.rs links `write`, which is both a function and a macro. Scope the check to the crates being changed or fix those two links.
        """
    observed_at git:19c5cd393ad6ee802170a789fd3fd1e4ff84bcdf
    author "claude"
    created_at 2026-11-03
}

record pixelkit.papercut.closing-a-papercut-through-knowledge-revise/1 : papercut {
    title "Closing a papercut through knowledge.revise with slots.closed_at =…"
    state verified
    statement """
        Closing a papercut through knowledge.revise with slots.closed_at = "2026-11-03" was rejected with AKR-T013 "expected a date, found \"2026-11-03\"" even though the schema advertises closed_at as date (YYYY-MM-DD); the MCP layer seems to pass the string where the parser wants a bare date literal. Left the papercut open.
        """
    observed_at git:2d8fbfd3a2dea14ca91a6867bc64a2d3b25ea1b7
    about "akr"
    author "claude"
    created_at 2026-11-03
}

